# Copie este archivo como ".env" (en la raiz del proyecto, junto a app/) y
# complete los valores.

# --- API Gateway (S3 Extraction Gateway Lambda) ---------------------------

# URL base del API Gateway desplegado (sin '/files' al final)
API_URL=https://api.midominio.com/s3

# API Key generada por el API Gateway (header x-api-key)
API_KEY=xxxxxxxxxxxxxxxxxxxxxxxx

# Prefijo S3 de archivos pendientes; debe coincidir con el SOURCE_PREFIX
# configurado en la Lambda
SOURCE_PREFIX=fractar/unprocessed/

# --- Descarga local ---------------------------------------------------------

# Carpeta local raiz donde se descargan los archivos (se conserva la
# estructura de relativePath debajo de esta carpeta)
DOWNLOAD_PATH=C:/Temp/Downloads

# Que hacer con el archivo local una vez confirmado como procesado:
#   true  (por defecto) -> se conserva, movido a DOWNLOAD_PATH/processed/<relativePath>
#   false               -> se elimina
KEEP_LOCAL_FILES=true

# Sub-ruta inicial de 'relativePath' (la que devuelve el API) que se debe
# quitar antes de armar la ruta local y la ruta en el SFTP. Util cuando
# 'relativePath' trae una carpeta de carga que no quieres replicar en el
# destino, y solo necesitas lo que viene despues de ella.
# Ejemplo: si relativePath = "carga/2026/07/15/xml/factura001.xml" y
# STRIP_RELATIVE_PREFIX=carga, el resultado usado es "2026/07/15/xml/factura001.xml".
# Vacio (por defecto) = no se recorta nada.
STRIP_RELATIVE_PREFIX=

# --- Servidor SFTP destino -------------------------------------------------

SFTP_HOST=192.168.1.20
SFTP_PORT=22
SFTP_USER=usuario
SFTP_PASSWORD=password

# Carpeta remota raiz (ruta absoluta); se conserva la estructura de
# relativePath debajo de esta carpeta
SFTP_REMOTE_PATH=/entrada

# --- Logging ----------------------------------------------------------------

LOG_LEVEL=INFO
LOG_FILE=logs/service.log

# --- Reintentos y timeouts ---------------------------------------------------

# Reintentos maximos ante errores transitorios (API, descarga, SFTP)
MAX_RETRIES=3

# Espera fija entre reintentos, en segundos
RETRY_WAIT_SECONDS=5

# Timeout de red para llamadas al API, descargas y operaciones SFTP, en segundos
REQUEST_TIMEOUT_SECONDS=30
