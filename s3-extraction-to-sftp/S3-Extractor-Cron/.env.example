# Copie este archivo como ".env" y complete los valores.

S3_BUCKET=mi-bucket-s3
S3_PREFIX=entrada/
PROCESSED_PREFIX=procesados/
AWS_REGION=us-east-1
LOCAL_DOWNLOAD_PATH=./downloads
LOG_FILE=./logs/s3_extractor.log
MAX_RETRIES=3
RETRY_BACKOFF_SECONDS=2

# Credenciales de AWS: NO se definen aquí. Use el mecanismo estándar de boto3
# (variables de entorno, ~/.aws/credentials, o rol IAM de instancia/tarea).
