    "serviceRawFile": "service: ammper-bpc-dev-manager-functions\n\nprovider:\n  name: aws\n  runtime: python3.12\n  stage: ${self:custom.stage}\n  region: ${self:custom.my-region}\n  environment:\n    REGION: ${self:provider.region}\n    STAGE: ${self:custom.stage}\n    INSTANCE_ID: ${self:custom.config.${self:custom.stage}.instance_id}\n\ncustom:\n  stage: ${opt:stage, 'dev'}\n  my-region: ${opt:region, 'us-east-1'}\n  config:\n    dev:\n      account_id: \"130871271678\"\n      memory_size: 128\n      # Reemplaza con el ID de tu EC2. Esta variable indica cuál instancia se prenderá o apagará.\n      instance_id: \"i-070be5a7f38a8714d\"\n    prod:\n      account_id: \"130871271678\"\n      memory_size: 128\n      instance_id: \"i-070be5a7f38a8714d\"\n\nfunctions:\n  startEc2:\n    name: ammper-bpc-dev-manager-start-${self:custom.stage}\n    handler: handler.start_ec2\n    role: arn:aws:iam::${self:custom.config.${self:custom.stage}.account_id}:role/AmmperBpcDevManagerRole\n    memorySize: ${self:custom.config.${self:custom.stage}.memory_size}\n    timeout: 30\n    events:\n      - schedule:\n          # Para encender a las 12:45pm (12:45) hora del centro de México (UTC-6) -> 18:45 UTC de Lunes a Viernes\n          rate: cron(45 18 ? * MON-FRI *)\n          enabled: true\n\n  stopEc2:\n    name: ammper-bpc-dev-manager-stop-${self:custom.stage}\n    handler: handler.stop_ec2\n    role: arn:aws:iam::${self:custom.config.${self:custom.stage}.account_id}:role/AmmperBpcDevManagerRole\n    memorySize: ${self:custom.config.${self:custom.stage}.memory_size}\n    timeout: 30\n    events:\n      - schedule:\n          # Para apagar a las 7:15pm (19:15) hora del centro de México (UTC-6) -> 01:15 UTC del día siguiente\n          # Lunes a Viernes en México (19:15) equivale a Martes a Sábado en UTC (01:15)\n          rate: cron(15 1 ? * TUE-SAT *)\n          enabled: true\n",
