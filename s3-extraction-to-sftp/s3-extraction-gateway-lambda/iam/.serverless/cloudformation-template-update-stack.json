{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "The AWS CloudFormation template for this Serverless application",
  "Resources": {
    "LambdaS3ExtractionGatewayRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "RoleName": "LambdaS3ExtractionGatewayRole",
        "MaxSessionDuration": 3600,
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "lambda.amazonaws.com"
              },
              "Action": [
                "sts:AssumeRole"
              ]
            }
          ]
        },
        "ManagedPolicyArns": [
          "arn:aws:iam::aws:policy/service-role/AWSLambdaBasicExecutionRole",
          {
            "Ref": "LambdaS3ExtractionGatewayPolicy"
          }
        ]
      }
    },
    "LambdaS3ExtractionGatewayPolicy": {
      "Type": "AWS::IAM::ManagedPolicy",
      "Properties": {
        "ManagedPolicyName": "LambdaS3ExtractionGatewayPolicy",
        "Description": "Permisos minimos para listar, leer, escribir y eliminar objetos del bucket configurado",
        "Path": "/",
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Action": [
                "s3:ListBucket"
              ],
              "Resource": [
                "arn:aws:s3:::energrid-documents"
              ]
            },
            {
              "Effect": "Allow",
              "Action": [
                "s3:GetObject",
                "s3:PutObject",
                "s3:DeleteObject"
              ],
              "Resource": [
                "arn:aws:s3:::energrid-documents/*"
              ]
            }
          ]
        }
      }
    }
  },
  "Outputs": {
    "ServerlessDeploymentBucketName": {
      "Value": "serverless-framework-deployments-us-east-1-5804d545-76c0",
      "Export": {
        "Name": "sls-mflores-s3-extraction-gateway-role-prod-ServerlessDeploymentBucketName"
      }
    }
  }
}